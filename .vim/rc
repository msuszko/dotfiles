" vim: fdm=marker ts=2 sts=2 sw=2 fdl=0
"
" Entry point shared by vim (~/.vimrc) and neovim (via init.vim).
" The actual configuration lives in conf/ next to this file.

if v:progname =~? "evim"
  finish
endif

" ~/.vimrc is a symlink to this file, so resolve it to find conf/
let g:vimrc = resolve(expand('<sfile>:p'))
let s:conf = fnamemodify(g:vimrc, ':h') . '/conf/'

for s:name in ['options', 'plugins', 'coc', 'legacy']
  execute 'source ' . fnameescape(s:conf . s:name . '.vim')
endfor
